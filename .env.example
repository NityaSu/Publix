# Supabase Storage — blog narration audio for /api/listen/{slug}.mp3
#
# Setup:
# 1. Supabase Dashboard → Storage → Create bucket "blog-audio"
# 2. Upload MP3 files named after each post slug (e.g. my-beijing-story.mp3)
# 3. For a private bucket, add a Storage policy allowing SELECT for authenticated
#    requests, OR use the service_role key server-side (recommended for API proxy).
# 4. Project Settings → API → copy Project URL and anon (or service_role) key
# 5. Copy this file to .env and fill in the values below

SUPABASE_URL=https://zpsburhenqatztcbnxov.supabase.co
SUPABASE_KEY=your_anon_key_here
