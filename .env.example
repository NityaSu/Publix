# Supabase Storage
#
# Audio:  private bucket "blog-audio"  → /api/listen/{slug}.mp3
# Media:  private bucket "site-media"  → /api/media/{path}
#
# Setup:
# 1. Project Settings → API → copy Project URL and service_role key (server-only)
# 2. Create bucket "blog-audio" and upload MP3s as {slug}.mp3
# 3. Create bucket "site-media" OR run: npm run upload:media
#    (uploads public/assets/** → site-media/images|videos/**)
# 4. Copy this file to .env and fill in the values below

SUPABASE_URL=https://zpsburhenqatztcbnxov.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key_here
