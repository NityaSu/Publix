# Supabase Storage
#
# Audio:  private bucket "blog-audio"  → /api/listen/{slug}.mp3
# Media:  private bucket "site-media"  → /api/media/{path}
#
# Setup:
# 1. Project Settings → API → copy Project URL and service_role key (server-only)
# 2. Create bucket "blog-audio" and upload MP3s as {slug}.mp3
# 3. Create bucket "site-media" OR run: npm run upload:media
#    (uploads public/assets/** → site-media/images|videos/**)
# 4. Copy this file to .env and fill in the values below
# 5. Blog view counters (rauchg.com style)
#    SQL Editor → paste supabase/page_views.sql → Run.
#    Counts live at /insights/notes. Production visits increment; local dev does not.

SUPABASE_URL=https://zpsburhenqatztcbnxov.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key_here

# Private draft notes (e.g. /insights/notes/backend-from-first-principle?key=...)
# Also accepted as NUXT_DRAFT_SECRET. Required in production or the page 404s.
DRAFT_SECRET=change-me-to-a-long-random-string

# Contact form (https://resend.com — free, ~3,000 emails/month)
# 1. Sign up with suonnitya@gmail.com so the test "from" address can deliver to you
# 2. API Keys → Create API Key → copy it here
# 3. Restart `npm run dev`. After that, /contact Submit emails you.
# In production, set the same var on the host (Vercel / Netlify / etc).
RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=suonnitya@gmail.com
# After you verify a domain in Resend, switch the from address:
# RESEND_FROM_EMAIL=Nitya Suon <hello@yourdomain.com>

# Optional: regenerate word timings with ElevenLabs Forced Alignment
# ELEVENLABS_API_KEY=your_elevenlabs_key
# Then: npm run generate:alignment -- --audio /path/to/narration.mp3
#
# Preferred free path (WhisperX forced align to known script):
#   1. python3 -m venv .venv && source .venv/bin/activate
#   2. pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
#   3. pip install whisperx
#   4. npm run align:whisperx -- /path/to/narration.mp3
